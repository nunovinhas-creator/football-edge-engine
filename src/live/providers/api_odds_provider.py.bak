import os
import requests


class APIOddsProvider:

    BASE_URL = "https://sports.bzzoiro.com"

    def __init__(self):

        self.api_key = os.getenv(
            "BSD_API_KEY"
        )

        if not self.api_key:
            raise RuntimeError(
                "BSD_API_KEY missing"
            )


    def get_live_odds(self, match_id):

        url = (
            f"{self.BASE_URL}/football/api/v2/"
            f"matches/{match_id}/odds/"
        )

        headers = {
            "Authorization": f"Token {self.api_key}"
        }


        response = requests.get(
            url,
            headers=headers,
            timeout=10
        )

        response.raise_for_status()

        return response.json()
